{
  "$schema": "https://raw.githubusercontent.com/binarylinuxx/dots/main/schemas/manifest.schema.json",
  "schema": 1,
  "type": "plugin",
  "id": "dev.blxshell.sysmon",
  "name": "System monitor",
  "version": "1.0.0",
  "description": "CPU, memory or temperature in the bar, with a usage ring that turns red past a threshold.",
  "authors": [
    {
      "name": "binarylinuxx",
      "url": "https://github.com/binarylinuxx"
    }
  ],
  "license": "MIT",
  "repository": "https://github.com/binarylinuxx/dots-plugins",
  "tags": [
    "system",
    "cpu",
    "memory",
    "temperature"
  ],
  "previews": [
    "screenshot.png"
  ],
  "blxshell": ">=0.1.0",
  "compositors": [
    "any"
  ],
  "plugin": {
    "api": 1,
    "exec": [
      "bin/sysmon.py"
    ],
    "restart": "on-failure",
    "permissions": [
      "shell"
    ],
    "barModules": [
      {
        "id": "monitor",
        "name": "System monitor",
        "description": "Scroll: next metric. Click: percent or detail. Right click: dashboard."
      }
    ],
    "commands": [
      "cpu",
      "memory",
      "temperature",
      "next"
    ],
    "settings": [
      {
        "key": "metric",
        "type": "choice",
        "label": "Show",
        "choices": [
          "cpu",
          "memory",
          "temperature"
        ],
        "default": "cpu"
      },
      {
        "key": "interval",
        "type": "number",
        "label": "Update every (s)",
        "default": 2
      },
      {
        "key": "warn",
        "type": "number",
        "label": "CPU and memory turn red above (%)",
        "default": 85
      },
      {
        "key": "warn_temp",
        "type": "number",
        "label": "Temperature turns red above (°C)",
        "default": 85
      },
      {
        "key": "ring",
        "type": "bool",
        "label": "Usage ring",
        "description": "Around the icon",
        "default": true
      }
    ]
  }
}
