{
  "$schema": "https://raw.githubusercontent.com/binarylinuxx/dots/main/schemas/manifest.schema.json",
  "schema": 1,
  "type": "plugin",
  "id": "dev.blxshell.netspeed",
  "name": "Network speed",
  "version": "1.0.0",
  "description": "Live download and upload rates of the active connection.",
  "authors": [
    {
      "name": "binarylinuxx",
      "url": "https://github.com/binarylinuxx"
    }
  ],
  "license": "MIT",
  "repository": "https://github.com/binarylinuxx/dots-plugins",
  "tags": [
    "network",
    "system"
  ],
  "previews": [
    "screenshot.png"
  ],
  "project": "blxshell",
  "blxshell": ">=0.1.0",
  "compositors": [
    "any"
  ],
  "plugin": {
    "api": 2,
    "facet": "plugin.facet",
    "exec": [
      "bin/netspeed.py"
    ],
    "restart": "on-failure",
    "permissions": []
  }
}
