{
  "$schema": "https://raw.githubusercontent.com/binarylinuxx/dots/main/schemas/manifest.schema.json",
  "schema": 1,
  "type": "plugin",
  "id": "dev.blxshell.desktop",
  "name": "Desktop icons",
  "version": "2.0.0",
  "description": "The files in your desktop folder as icons on the wallpaper, shaped and tinted like Android's adaptive icons if you like. Click one for its actions: open, open with another app, show in folder, copy path, move to trash.",
  "authors": [
    {
      "name": "binarylinuxx",
      "url": "https://github.com/binarylinuxx"
    }
  ],
  "license": "MIT",
  "repository": "https://github.com/binarylinuxx/dots-plugins",
  "tags": [
    "desktop",
    "files",
    "icons"
  ],
  "previews": [
    "screenshot.png"
  ],
  "project": "blxshell",
  "blxshell": ">=0.1.0",
  "compositors": [
    "any"
  ],
  "plugin": {
    "api": 2,
    "facet": "plugin.facet",
    "native": "lib/plugin.so",
    "permissions": [
      "native",
      "filesystem",
      "spawn"
    ]
  }
}
