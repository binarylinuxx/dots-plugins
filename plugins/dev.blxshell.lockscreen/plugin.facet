// Lock screen widgets: lib/plugin.so (src/plugin.cpp) draws the widgets; this
// is its page in Settings. Each widget's own settings (manifest.json,
// lockOptions) are in the lock screen layout editor.
let [ vw.ui as ui, vw.layout as layout ] in

view Settings(state, actions) {
    layout.Column(gap: 12, width: state.width, align: start) {
        ui.Text(text: "Add the widgets in Settings → Lock screen → Edit layout → Add. Select one there to set what it shows: the greeting's name and colour, the message and its icon, the calendar's first weekday, the countdown's date, the system line's parts.",
                font: state.fonts.text, size: 15, color: state.colours.text, max_width: state.width)
        ui.Text(text: "Add a widget twice, or duplicate it, for two with different settings: a message card for your contact details and one for a reminder.",
                font: state.fonts.text, size: 14, color: state.colours.textMuted, max_width: state.width)
    }
}
